# Start in dark mode (press F8 anytime to toggle off for books like Zero to Production in Rust)
default_dark_mode 1

# Soften dark mode contrast slightly so code blocks aren't harsh
dark_mode_background_color 0.11 0.12 0.14
dark_mode_contrast 0.85

# Fit page cleanly inside window on open
fit_to_page_width_ratio 0.90
startup_commands fit_to_page_height

